# Copy this file to .env. Never commit the completed .env file.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://regional-tourism-scan.vercel.app
DATABASE_URL=postgresql+psycopg://rgap:rgap_local_only@localhost:5432/rgap

# One Data.go.kr key shared by every approved KTO dataset.
KTO_TOURISM_DATALAB_API_KEY=

# Keep only if you will connect these sources.
LOCAL_FINANCE365_API_KEY=
KOSIS_API_KEY=

# KOSIS is already keyed above. These are not secrets: copy the table/selector
# information from KOSIS's generated API URL after choosing all municipalities.
# KOSIS_POPULATION_ORG_ID=101
# KOSIS_POPULATION_TABLE_ID=DT_1B040A3
# KOSIS_POPULATION_QUERY=  # generated URL query string excluding apiKey
# KOSIS_AREA_ORG_ID=
# KOSIS_AREA_TABLE_ID=
# KOSIS_AREA_QUERY=        # generated URL query string excluding apiKey

# Add these later only after copying the exact operation name or API base URL
# from the provider documentation. They are not additional API keys.
# KTO_ATTRACTION_CONCENTRATION_ENDPOINT=
# KTO_TOURISM_RESOURCE_DEMAND_ENDPOINT=
# KTO_RELATED_ATTRACTIONS_ENDPOINT=
# MOIS_TOURISM_BUSINESS_BASE_URL=
# MOIS_TOURISM_BUSINESS_QUERY=
# LOCAL_FINANCE365_BASE_URL=

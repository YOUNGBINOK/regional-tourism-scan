# Copy this file to .env. Never commit the completed .env file.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://regional-tourism-scan.vercel.app
DATABASE_URL=postgresql+psycopg://rgap:rgap_local_only@localhost:5432/rgap

# One Data.go.kr key shared by every approved KTO dataset.
KTO_TOURISM_DATALAB_API_KEY=

# Keep only if you will connect these sources.
LOCAL_FINANCE365_API_KEY=
KOSIS_API_KEY=

